{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "msbt-checkout",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SITE_URL": "https://www.msbt.co.uk"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
